# Local secrets and the virtual environment.
.env
.env.*
!.env.example
.venv/
.venv-train/

# Python caches and build output.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Dataset files stay local. metadata/ is the only tracked part of datasets/.
datasets/*
!datasets/metadata/
!datasets/metadata/**

# Model weights stay local.
models/

# Node dependencies and Next.js build output.
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Ultralytics scratch downloads (CLIP text encoder, AMP-check model).
weights/
