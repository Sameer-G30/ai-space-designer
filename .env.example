# Local Postgres role, database, and published port.
POSTGRES_USER=spacedesigner
POSTGRES_PASSWORD=spacedesigner
POSTGRES_DB=spacedesigner
POSTGRES_PORT=5432

# SQLAlchemy URL used by Alembic and the session helper.
DATABASE_URL=postgresql+psycopg://spacedesigner:spacedesigner@127.0.0.1:5432/spacedesigner

# Port for the FastAPI process. 8000 is left free for other local apps.
API_PORT=8001
